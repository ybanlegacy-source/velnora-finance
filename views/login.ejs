<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Velnora Finance — Sign In</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="banner">Demo project — no real money or accounts involved</div>
  <div class="login-wrap">
    <div class="login-card">
    <img src="/images/logo.png" alt="Velnora Finance" class="login-logo">

      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <input type="text" name="username" placeholder="Username" required autofocus>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Sign In</button>
      </form>

      <p class="auth-alt">New here? <a href="/create-account">Create an account</a></p>
      <p class="auth-alt"><a href="/">← Back to homepage</a></p>
    </div>
  </div>
</body>
</html>