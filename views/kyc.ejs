<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Verification — Velnora Finance</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="banner">Demo project — verification here is a simple CAPTCHA for class demonstration purposes</div>
  <%- include('partials/app-header') %>

  <div class="kyc-page-wrap">
    <div class="kyc-page-header">
      <h1>Account Verification</h1>
      <p>To prove that you're not a robot, complete the quick check below to verify your account.</p>
    </div>

    <% if (user.email_verified) { %>
      <div class="kyc-status-card kyc-status-approved">
        <div class="kyc-status-icon">✅</div>
        <div>
          <h2>You're verified</h2>
          <p>Your account is fully verified. No further action is needed.</p>
        </div>
      </div>

    <% } else { %>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <form method="POST" action="/kyc/verify-captcha" class="loan-section-card" style="text-align:center;">
        <p style="margin-bottom:16px; color:#33454b; font-size:1.05rem;">
          What is <strong><%= question %></strong>?
        </p>
        <input type="number" name="captchaAnswer" placeholder="Your answer" required
               style="max-width:200px; margin:0 auto 20px; display:block; text-align:center; font-size:1.1rem;">
        <button type="submit" class="btn-hero-primary loan-submit-btn">Verify</button>
      </form>
    <% } %>
  </div>

  <%- include('partials/bottom-nav') %>
</body>
</html>