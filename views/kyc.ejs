<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Verification — Velnora Finance</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="banner">Demo project — verification emails are for class demonstration purposes only</div>
  <%- include('partials/app-header') %>

  <div class="kyc-page-wrap">
    <div class="kyc-page-header">
      <h1>Account Verification</h1>
      <p>Verify your email address to unlock full access to your Velnora Finance account.</p>
    </div>

    <% if (user.email_verified) { %>
      <div class="kyc-status-card kyc-status-approved">
        <div class="kyc-status-icon">✅</div>
        <div>
          <h2>You're verified</h2>
          <p>Your account is fully verified<% if (justVerified) { %> — thanks for confirming your email!<% } %></p>
        </div>
      </div>

    <% } else if (sent) { %>
      <div class="kyc-status-card kyc-status-pending">
        <div class="kyc-status-icon">📧</div>
        <div>
          <h2>Check your inbox</h2>
          <p>We've sent a verification link to your email. Click it to finish verifying your account.</p>
        </div>
      </div>

    <% } else { %>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <div class="loan-section-card" style="text-align:center;">
        <p style="margin-bottom:20px; color:#33454b;">You haven't verified your email yet. Click below to get started.</p>
        <button type="button" class="btn-hero-primary loan-submit-btn" onclick="openVerifyModal()">Verify My Email</button>
      </div>
    <% } %>
  </div>

  <!-- Email verification modal -->
  <div class="modal-overlay" id="verifyModalOverlay" onclick="if(event.target===this) closeVerifyModal()">
    <div class="modal-box">
      <h3>Verify Your Email</h3>
      <form method="POST" action="/kyc/send-verification">
        <input type="email" name="email" placeholder="you@example.com" required>
        <div class="modal-actions">
          <button type="button" class="btn-cancel" onclick="closeVerifyModal()">Cancel</button>
          <button type="submit" class="btn-primary">Send Verification Link</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('partials/bottom-nav') %>

  <script>
    function openVerifyModal() {
      document.getElementById('verifyModalOverlay').classList.add('open');
    }
    function closeVerifyModal() {
      document.getElementById('verifyModalOverlay').classList.remove('open');
    }
  </script>
</body>
</html>