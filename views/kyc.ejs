<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Verification — Velnora Finance</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="banner"><%= __('kyc_demo_banner') %></div>
  <%- include('partials/app-header') %>

  <div class="kyc-page-wrap">
    <div class="kyc-page-header">
      <h1><%= __('kyc_title') %></h1>
      <p><%= __('kyc_subtitle') %></p>
    </div>

    <% if (user.email_verified) { %>
      <div class="kyc-status-card kyc-status-approved">
        <div class="kyc-status-icon">✅</div>
        <div>
          <h2><%= __('kyc_verified_title') %></h2>
          <p><%= __('kyc_verified_msg') %></p>
        </div>
      </div>

    <% } else { %>
      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <form method="POST" action="/kyc/verify-captcha" class="loan-section-card" style="text-align:center;">
        <p style="margin-bottom:16px; color:#33454b; font-size:1.05rem;">
          <%= __('kyc_question_prefix') %> <strong><%= question %></strong>?
        </p>
        <input type="number" name="captchaAnswer" placeholder="<%= __('kyc_answer_placeholder') %>" required
               style="max-width:200px; margin:0 auto 20px; display:block; text-align:center; font-size:1.1rem;">
        <button type="submit" class="btn-hero-primary loan-submit-btn"><%= __('verify') %></button>
      </form>
    <% } %>
  </div>

  <%- include('partials/bottom-nav') %>
</body>
</html>