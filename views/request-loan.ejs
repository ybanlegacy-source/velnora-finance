<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Request a Loan — Velnora Finance</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="banner"><%= __('loan_demo_banner') %></div>
  <%- include('partials/app-header') %>

  <div class="loan-page-wrap">
    <div class="loan-page-header">
      <h1><%= __('loan_page_title') %></h1>
      <p><%= __('loan_page_subtitle') %></p>
    </div>

    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="msg-flash"><%= __('loan_submitted_msg') %></div>
    <% } %>

    <form method="POST" action="/request-loan" id="loanForm">

      <div class="loan-section-card">
        <h2 class="loan-section-title"><%= __('personal_info') %></h2>

        <div class="loan-grid">
          <div class="form-field">
            <label><%= __('full_name') %></label>
            <input type="text" name="full_name" required value="<%= user.full_name || '' %>">
          </div>

          <div class="form-field">
            <label><%= __('employment_status') %></label>
            <select name="employment_status" required>
              <option value=""><%= __('select_placeholder') %></option>
              <option value="Full-Time"><%= __('emp_full_time') %></option>
              <option value="Part-Time"><%= __('emp_part_time') %></option>
              <option value="Self-employed"><%= __('emp_self_employed') %></option>
              <option value="Retired"><%= __('emp_retired') %></option>
              <option value="Student"><%= __('emp_student') %></option>
              <option value="Unemployed"><%= __('emp_unemployed') %></option>
            </select>
          </div>

          <div class="form-field">
            <label><%= __('annual_income') %></label>
            <select name="income_range" required>
              <option value=""><%= __('select_placeholder') %></option>
              <option>$10,000 - $25,000</option>
              <option>$25,001 - $50,000</option>
              <option>$50,001 - $75,000</option>
              <option>$75,001 - $100,000</option>
              <option>$100,001 - $150,000</option>
              <option>$150,001 - $200,000</option>
              <option>$200,000+</option>
            </select>
          </div>
        </div>
      </div>


      <!-- ============ LOAN DETAILS ============ -->
      <div class="loan-section-card">
        <h2 class="loan-section-title"><%= __('loan_details') %></h2>

        <div class="loan-grid">
          <div class="form-field">
            <label><%= __('loan_amount') %></label>
            <input type="number" name="amount" step="0.01" min="1" required>
          </div>

          <div class="form-field">
            <label><%= __('loan_type') %></label>
            <select name="loan_type" required>
              <option value=""><%= __('select_placeholder') %></option>
              <option value="Personal Loan"><%= __('loan_type_personal') %></option>
              <option value="Mortgage"><%= __('loan_type_mortgage') %></option>
              <option value="Home Equity Loan"><%= __('loan_type_home_equity') %></option>
              <option value="Student Loan"><%= __('loan_type_student') %></option>
              <option value="Small Business Loan"><%= __('loan_type_business') %></option>
            </select>
          </div>

          <div class="form-field">
            <label><%= __('loan_term') %></label>
            <select name="term" required>
              <option value=""><%= __('select_placeholder') %></option>
              <option value="3 months"><%= __('term_3m') %></option>
              <option value="6 months"><%= __('term_6m') %></option>
              <option value="12 months"><%= __('term_12m') %></option>
              <option value="36 months"><%= __('term_36m') %></option>
            </select>
          </div>
        </div>

        <div class="form-field form-field-full">
          <label><%= __('reason_for_loan') %></label>
          <textarea name="purpose" rows="4" required placeholder="<%= __('reason_placeholder') %>"></textarea>
        </div>
      </div>

      <button type="submit" class="btn-hero-primary loan-submit-btn"><%= __('submit_loan_request') %></button>
    </form>

    <div class="loan-section-card loan-history-card">
      <h2 class="loan-section-title"><%= __('your_loan_requests') %></h2>
      <% if (loans.length === 0) { %>
        <p class="loan-history-empty"><%= __('no_loan_requests_yet') %></p>
      <% } else { %>
        <div class="loan-history-scroll">
          <table>
            <thead>
              <tr>
                <th><%= __('table_amount') %></th>
                <th><%= __('table_type') %></th>
                <th><%= __('table_term') %></th>
                <th><%= __('table_purpose') %></th>
                <th><%= __('table_date') %></th>
              </tr>
            </thead>
            <tbody>
              <% loans.forEach(l => { %>
                <tr>
                  <td><%= fmtMoney(l.amount) %></td>
                  <td><%= l.loan_type || '—' %></td>
                  <td><%= l.term %></td>
                  <td><%= l.purpose %></td>
                  <td><%= new Date(l.created_at).toLocaleDateString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/bottom-nav') %>

</body>
</html>